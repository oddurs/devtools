[12.108,"o","\r\u001b[90m# Defined in /root/.config/fish/functions/mcdir.fish @ line 1\u001b[30m\u001b(B\u001b[m\r\n\u001b[35mfunction\u001b[30m\u001b(B\u001b[m mcdir \u001b[90m--description \u001b[32m'Create a directory and enter it'\u001b[33m\r\n\u001b[30m\u001b(B\u001b[m    \u001b[35mif\u001b[30m\u001b(B\u001b[m \u001b[36mtest \u001b[33m(\u001b[36mcount \u001b[33m$argv)\u001b[30m\u001b(B\u001b[m \u001b[90m-ne \u001b[30m\u001b(B\u001b[m1\u001b[33m;\u001b[30m\u001b(B\u001b[m \u001b[33mor\u001b[30m\u001b(B\u001b[m \u001b[36mtest \u001b[90m-z \u001b[32m\"\u001b[33m$argv[\u001b[30m\u001b(B\u001b[m1\u001b[33m]\u001b[32m\"\u001b[33m\r\n\u001b[30m\u001b(B\u001b[m        \u001b[36mprintf \u001b[32m'%s\\n'\u001b[30m\u001b(B\u001b[m \u001b[32m'usage: mcdir <directory>'\u001b[30m\u001b(B\u001b[m \u001b[33m>&2\r\n\u001b[30m\u001b(B\u001b[m        \u001b[36mret"]
