[12.62,"o","# layers, each over the one before:\r\n#   default\r\n#   user          /root/.config/nun/nun.toml (none)\r\n#   editorconfig  per file; `nun config <file>` includes it\r\n#   project       no .nun.toml here\r\n\r\n[editor]\r\ntab_width = 4\r\n\r\n[theme]\r\npolarity = \"auto\"\r\n# [theme.roles] — none overridden; all derived\r\n\r\n[ui]\r\nmouse = true\r\nalternate_screen = true\r\nkeyboard_enhancement = true\r\nhyperlinks = true\r\nlightbulb = true\r\nundercurl = \"auto\"\r\nclipboard = \"auto\"\r\ntruecolor = \"auto\"\r\nhover_delay_ms = 400\r\n# double_click_ms — the platform's usual value\r\n\r\n# [keys] — none added; the defaults are listed by `nun keys`\r\n\r\n[glyphs]\r\npreset = \"default\"\r\n# none changed; every role is listed by `nun glyphs`\r\n\r\n[lsp.c]\r\ncommand = \"clangd\"\r\nargs = []\r\nformat_on_save = false\r\n\r\n[lsp.cpp]\r\ncommand = \"clangd\"\r\nargs = []\r\nformat_on_save = false\r\n\r\n[lsp.go]\r\ncommand = \"gopls\"\r\nargs = []\r\nformat_on_save = true\r\n\r\n[lsp.javascript]\r\ncommand = \"typescript-language-server\"\r\nargs = [\"--stdio\"]\r\nformat_on_save = false\r\n\r\n[lsp.python]\r\ncommand = \"pyright-langserver\"\r\nargs = [\"--stdio\"]\r\nformat_on_save = false\r\n\r\n[lsp.rust]\r\ncommand = \"rust-analyzer\"\r\nargs = []\r\nformat_on_save = true\r\n\r\n[lsp.typescript]\r\ncommand = \"typescript-language-server\"\r\nargs = [\"--stdio\"]\r\nformat_on_save = false\r\n\r\n# glyphs in use: preset \"default\"; `nun glyphs` has code points and widths\r\n#   Editor           fold.open ▾ fold.closed ▸ fold.hidden ⋯ lightbulb ◊ change.added ▐ change.modified ╏ change.removed.above ¯ change.removed.below _\r\n#   Rail             rail.1 ▎ rail.2 ▌ rail.3 ▊ rail.4 █\r\n#   Tabs             tab.close × tab.modified • tab.drop ▏\r\n#   Status line      status.sidebar.shown ◧ status.sidebar.hidden ▯ diagnostic.error ✕ diagnostic.warning ▲ diagnostic.info ● status.terminal ❯\r\n#   File tree        tree.new_file + tree.new_folder ▪ tree.ignored.hidden ○ tree.ignored.shown ● tree.expanded ▾ tree.collapsed ▸ tree.symlink ↪\r\n#   Search           search.icon ⌕ search.replace → search.back ▤ search.apply ⇓ search.regex * search.case A search.word ▭ search.ignored ○\r\n#   Replace preview  replace.removed - replace.added + replace.included ✓ replace.excluded · replace.line_break ↵\r\n#   Cards            card.previous ‹ card.next › card.above ▴ card.below ▾ card.bullet • card.quote │ card.task.done ☑ card.task.open ☐\r\n#   Terminal         terminal.new + terminal.split ◫ terminal.close × terminal.hide ▾\r\n#   Diff             diff.added + diff.removed - diff.filler ╱ diff.close ×\r\n#   Everywhere       ellipsis … rule.horizontal ─ rule.vertical │\r\n"]
