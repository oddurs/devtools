[0.99,"o","\u001b[1;1H\u001b[38;2;217;216;211;48;2;13;13;12m README.md × \u001b[38;2;131;130;127;48;2;19;19;18m                                                                                                                \u001b[2;1H\u001b[38;2;217;216;211;48;2;18;18;17m  \u001b[1m\u001b[38;2;131;130;127;48;2;13;13;12m1\u001b[22m\u001b[38;2;217;216;211;48;2;18;18;17m   \u001b[38;2;0;0;0;48;2;135;186;253m#\u001b[38;2;217;216;211;48;2;18;18;17m nun                                                                                                                  \u001b[3;1H\u001b[38;2;217;216;211;48;2;13;13;12m  \u001b[38;2;89;89;86;48;2;13;13;12m2\u001b[38;2;217;216;211;48;2;13;13;12m                                                                                                                          \u001b[4;1H  \u001b[38;2;89;89;86;48;2;13;13;12m3\u001b[38;2;217;216;211;48;2;13;13;12m   [![ci](https://github.com/oddurs/nun/actions/workflows/ci.yml/badge.svg)](https://github.com/oddurs/nun/actions/workflo\u001b[5;1H  \u001b[38;2;89;89;86;48;2;13;13;12m4\u001b[38;2;217;216;211;48;2;13;13;12m   [![license: MIT](https://img.shields.io/badge/license-MIT-blue.svg)](LICENSE)                                          \u001b[6;1H  \u001b[38;2;89;89;86;48;2;13;13;12m5\u001b[38;2;217;216;211;48;2;13;13;12m                                                                                                                          \u001b[7;1H  \u001b[38;2;89;89;86;48;2;13;13;12m6\u001b[38;2;217;216;211;48;2;13;13;12m   A terminal code editor you drive with the mouse, that borrows its colours from                                         \u001b[8;1H  \u001b[38;2;89;89;86;48;2;13;13;12m7\u001b[38;2;217;216;211;48;2;13;13;12m   the terminal it is already running in, and that ships with one config file you                                         \u001b[9;1H  \u001b[38;2;89;89;86;48;2;13;13;12m8\u001b[38;2;217;216;211;48;2;13;13;12m   will mostly never open.                                                                                                \u001b[10;1H  \u001b[38;2;89;89;86;48;2;13;13;12m9\u001b[38;2;217;216;211;48;2;13;13;12m                                                                                    "]
[0.995,"o","                                      \u001b[11;1H \u001b[38;2;89;89;86;48;2;13;13;12m10\u001b[38;2;217;216;211;48;2;13;13;12m   ## Status                                                                                                              \u001b[12;1H \u001b[38;2;89;89;86;48;2;13;13;12m11\u001b[38;2;217;216;211;48;2;13;13;12m                                                                                                                          \u001b[13;1H \u001b[38;2;89;89;86;48;2;13;13;12m12\u001b[38;2;217;216;211;48;2;13;13;12m   Early. The editor is being built one milestone at a time; the roadmap lives in                                         \u001b[14;1H \u001b[38;2;89;89;86;48;2;13;13;12m13\u001b[38;2;217;216;211;48;2;13;13;12m   [`cairn/`](cairn/) and is the source of truth.                                                                         \u001b[15;1H \u001b[38;2;89;89;86;48;2;13;13;12m14\u001b[38;2;217;216;211;48;2;13;13;12m                                                                                                                          \u001b[16;1H \u001b[38;2;89;89;86;48;2;13;13;12m15\u001b[38;2;217;216;211;48;2;13;13;12m   What works today — milestones 1 and 2, and the start of 3:                                                             \u001b[17;1H \u001b[38;2;89;89;86;48;2;13;13;12m16\u001b[38;2;217;216;211;48;2;13;13;12m                                                                                                                          \u001b[18;1H \u001b[38;2;89;89;86;48;2;13;13;12m17\u001b[38;2;217;216;211;48;2;13;13;12m   ```sh                                                                                                                  \u001b[19;1H \u001b[38;2;89;89;86;48;2;13;13;12m18\u001b[38;2;217;216;211;48;2;13;13;12m   nun <file>         # open it, edit it, save it                                                                         \u001b[20;1H \u001b[38;2;89;89;86;48;2;13;13;12m19\u001b[38;2;217;216;211;48;2;13;13;12m   nun <folder>       # open it with the file tree beside it                                                              \u001b[21;1H \u001b[38;2;89;89;86;48;2;13;13;12m20\u001b[38;2;217;216;211;48;2;13;13;12m   nun keys           # every command and the keys bound to it                                                            \u001b[22;1H \u001b[38;2;89;89;86;48;2;13;13;12m21\u001b[38;2;217;216;211;48;2;13;13;12m   nun glyphs         # every mark nun draws, and what it draws it with                                                   \u001b[23;1H \u001b[38;2;89;89;86;48;2;13;13;12m22\u001b[38;2;217;216;211;48;2;13;13;12m   nun config         # print the effective configuration and where each value came from                                  \u001b[24;1H \u001b[38;2;89;89;86;48;2;13;13;12m23\u001b[38;2;217;216;211;48;2;13;13;12m   nun theme dump     # probe this terminal and print the derived ramp as TOML                                            \u001b[25;1H \u001b[38;2;89;89;86;48;2;13;13;12m24\u001b[38;2;217;216;211;48;2;13;13;12m   ```                                                                                                                    \u001b[26;1H \u001b[38;2;89;89;86;48;2;13;13;12m25\u001b[38;2;217;216;211;48;2;13;13;12m                               "]
[0.996,"o","                                                                                           \u001b[27;1H \u001b[38;2;89;89;86;48;2;13;13;12m26\u001b[38;2;217;216;211;48;2;13;13;12m   You get a full-screen editor with line numbers, a status line, and colours                                             \u001b[28;1H \u001b[38;2;89;89;86;48;2;13;13;12m27\u001b[38;2;217;216;211;48;2;13;13;12m   derived from your own terminal. Typing, arrow keys and shift-selection, undo and                                       \u001b[29;1H \u001b[38;2;89;89;86;48;2;13;13;12m28\u001b[38;2;217;216;211;48;2;13;13;12m   redo, select all, page up and down, save, and a quit that asks twice if there                                          \u001b[30;1H \u001b[38;2;89;89;86;48;2;13;13;12m29\u001b[38;2;217;216;211;48;2;13;13;12m   are unsaved changes.                                                                                                   \u001b[31;1H\u001b[38;2;217;216;211;48;2;34;34;33m ▯  ⌕  ❯ \u001b[38;2;0;0;0;48;2;135;186;253mThis terminal has no Kitty keyboard protocol, so nun is using the basic key set. `nun keys` lists it (docs/keys.md).\u001b[39m\u001b[49m\u001b[0m\u001b[?25l"]
